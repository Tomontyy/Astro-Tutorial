---
import BlogPost from "../components/BlogPost.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "Blog Posts";
---

<BaseLayout pageTitle={pageTitle}>
<h2>A sexy sexy blog</h2>

		<p>Woah okay so today i've learn't to make a basic ass website with navigation and text.</p>
        <p>Heeeeellllllll fricken Yeaaaaaah!!!</p>
<ul>
    {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
</ul>
</BaseLayout>